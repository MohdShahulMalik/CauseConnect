{
  "name": "causeconnect",
  "version": "1.0.0",
  "private": true,
  "description": "CauseConnect - A mobile-first social network for volunteers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:api": "cd apps/api && ./mvnw clean package -DskipTests",
    "build:mobile": "cd apps/mobile && bun run export",
    "serve:api": "cd apps/api && ./mvnw spring-boot:run",
    "serve:mobile": "cd apps/mobile && bun run start",
    "test": "nx run-many --target=test --all",
    "test:api": "cd apps/api && ./mvnw test",
    "test:mobile": "cd apps/mobile && bun run test",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "generate:api": "cd packages/api-client && bun run generate",
    "lint": "nx run-many --target=lint --all",
    "affected": "nx affected",
    "graph": "nx graph"
  },
  "devDependencies": {
    "nx": "^20.0.0",
    "typescript": "^5.5.0",
    "oxlint": "^0.15.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
