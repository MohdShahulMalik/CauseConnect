{
  "name": "@causeconnect/api-client",
  "version": "1.0.0",
  "description": "TypeScript client for CauseConnect API - generated from OpenAPI spec",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript-codegen --input ../apps/api/openapi.yaml --output ./src/generated --client vue-ts",
    "generate:fetch": "openapi-typescript-codegen --input ../apps/api/openapi.yaml --output ./src/generated --client fetch",
    "clean": "rm -rf ./src/generated",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json . --fix"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
